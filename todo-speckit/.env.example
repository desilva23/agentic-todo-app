# Copy this file to .env. Never commit .env.

# Where the SQLite database file is stored (optional, default: todos.db)
TODO_DB_PATH=todos.db

# --- AI assistant (chat box). Core todos work without these. ---

# Your GroqCloud API key (https://console.groq.com). Keep it only in .env.
GROQ_API_KEY=

# Which Groq model to use (optional). Others that worked in testing: openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b

# Seconds to wait for Groq before giving up (optional, default 15)
GROQ_TIMEOUT_SECONDS=15
